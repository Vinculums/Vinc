# 배포 산출물은 리눅스에서 실행된다 — 반드시 LF 로 체크아웃한다.
# (Windows 작업트리에서 tar/scp 로 서버에 올릴 때 CRLF 가 섞이면 bash `set -euo
#  pipefail\r` 같은 파싱 오류·cron/systemd 오작동이 난다. deploy 브링업 중 실측.)
*.sh        text eol=lf
*.service   text eol=lf
*.cron      text eol=lf
*.py        text eol=lf
# Dockerfile 은 리눅스 러너의 도커가 읽는다. CRLF 로 체크아웃되면 `RUN` 의 줄
# 이음이 `` 을 달고 셸로 들어간다 — 위 *.sh 와 같은 이유다.
Dockerfile* text eol=lf
Caddyfile   text eol=lf
deploy/**   text eol=lf
scripts/**  text eol=lf

# 역할 껍데기는 agents_sync.py --gen 이 LF 로 쓴다. 이 줄이 없으면 체크아웃이 CRLF 로
# 되돌려, 내용이 하나도 안 바뀌어도 --gen 마다 열여섯 파일이 수정으로 뜬다. 늘 시끄러운
# 신호는 읽히지 않고 진짜 변경 하나가 그 속에 숨는다.
agents/shells/** text eol=lf
# 그 껍데기를 만드는 스냅샷도 같은 생성기가 LF 로 쓴다(`write_snapshot`). 위 줄만 있고
# 이 줄이 없어서, --pull 은 내용 차이가 0 인 날에도 roles.json 을 늘 수정으로 띄웠다.
# 그 소음이 가리는 것이 바로 이 파일이 보여줘야 하는 것 — 그래프가 앞서간 만큼이다.
agents/roles.json text eol=lf

# ladybug 확장 해시 목록은 릴리스 러너가 `-c` 로 읽는다. CRLF 로 체크아웃되면 파일 이름
# 끝에 `` 가 붙는데, GNU sha256sum 은 넘기지만 perl `shasum` 은 파일을 못 읽는다(실측).
packaging/lbug-ext-*.sha256 text eol=lf

# 폰트는 바이너리다. Windows 작업트리에서 텍스트로 오인되면 CRLF 변환이 파일을
# 깨뜨리는데, 그 고장은 "글자가 폴백으로 뜬다"로만 보여 원인까지 멀다.
*.woff2     binary
rag_eval/evalsets/** text eol=lf
