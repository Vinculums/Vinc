# 릴리스 리눅스 다리의 빌드 환경. `.github/workflows/release.yml` 의 `build` 잡이
# 이 이미지 **안에서** 리눅스 설치본을 짓는다.
#
# ⚠ **베이스는 22.04 여야 한다 — 취향이 아니라 계약이다.** 여기서 지은 바이너리의
# 최소 glibc 가 빌드 환경의 glibc 다(22.04 = 2.35). 러너 기계는 WSL 의 Ubuntu 24.04
# (2.39)라 컨테이너 없이 지으면 사용자 바닥이 조용히 올라간다 — CI 는 그걸 안
# 잡아 주고 사용자가 잡는다(v0.8.2 까지 호스티드 `ubuntu-22.04` 로 출하됐다).
# 이 줄을 올리는 것은 **누가 Vinc 를 실행할 수 있는가를 바꾸는 일**이다.
FROM ubuntu:22.04

# ── 왜 이미지를 미리 굽나 ────────────────────────────────────────────────────
# 처음 판은 이 목록을 워크플로 스텝에서 매번 apt 로 깔았다. 실측(런 34030111531):
# 준비물 636초 + webkit deps 865초 = **25분**. 다운로드가 아니라 dpkg 언팩이고,
# 도커 오버레이가 WSL 위에서 작은 쓰기에 느린 것이 원인이다(러너의 TMPDIR 이
# 49분과 4분을 가르는 것과 같은 종류). 이미지로 구우면 그 25분이 레이어 캐시가
# 되어 릴리스마다 0 이 된다. Dockerfile 이 안 바뀌면 `docker build` 는 몇 초다.
ENV DEBIAN_FRONTEND=noninteractive

# 호스티드 `ubuntu-22.04` **러너 이미지**에는 들어 있고 `ubuntu:22.04` **도커
# 이미지**에는 없는 것. 이 잡이 실제로 부르는 것만 적었다:
#   ca-certificates  다운로드 전부(setup-python·setup-node·확장 시드)
#   curl jq gh       runner-preflight 가 요구하는 셋. 업로드 스텝이 셋 다 부른다
#   git              actions/checkout. 없으면 REST tarball 로 조용히 강등된다
#   sudo             워크플로가 호스티드 다리와 공유하는 스텝들이 sudo 를 부른다
#   build-essential pkg-config  rustc 의 링커와 tauri 의 시스템 라이브러리 탐색
#   file             linuxdeploy(AppImage 번들러)가 부른다
#   xz-utils         setup-node 가 받는 tarball
RUN apt-get update -qq && apt-get install -y -qq --no-install-recommends \
      ca-certificates curl jq git sudo file xz-utils \
      build-essential pkg-config \
 && rm -rf /var/lib/apt/lists/*

# ⚠ `gh` 는 22.04 의 apt 에 **없다**(23.04 부터 universe 에 들어왔다). 공식 저장소를
# 붙인다. 이게 빠지면 preflight 가 2초에 세운다 — 그게 그 액션의 존재 이유다.
RUN install -d -m 0755 /etc/apt/keyrings \
 && curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
      -o /etc/apt/keyrings/githubcli-archive-keyring.gpg \
 && chmod go+r /etc/apt/keyrings/githubcli-archive-keyring.gpg \
 && echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
      > /etc/apt/sources.list.d/github-cli.list \
 && apt-get update -qq && apt-get install -y -qq gh \
 && rm -rf /var/lib/apt/lists/*

# Tauri 셸이 링크하는 시스템 헤더. ⚠ 이 목록의 정본은 여기다 — 워크플로에 있던
# "Linux webkit deps" 스텝을 이리로 옮겼다(리눅스 다리가 컨테이너뿐이라 그 스텝은
# 이 이미지가 하는 일을 매번 다시 하는 것이었다). 호스티드 macOS·윈도우 다리는
# 이 목록과 무관하다.
RUN apt-get update -qq && apt-get install -y -qq \
      libwebkit2gtk-4.1-dev libappindicator3-dev librsvg2-dev patchelf libdbus-1-dev \
 && rm -rf /var/lib/apt/lists/*

# ── 컨테이너를 root 로 돌리지 않는다 ─────────────────────────────────────────
# 작업 디렉터리는 **러너 기계의 디스크**를 마운트한 것이라, root 로 돌면 이 잡이
# 만든 파일이 호스트에 `root:root` 로 남고 다음에 같은 러너에서 도는 컨테이너
# 아닌 잡의 `actions/checkout` 이 그걸 지우려다 permission denied 로 죽는다.
# ⚠ 잡 끝에서 `chown` 하는 것으로는 **부족하다**. 액션의 post 스텝은 마지막 일반
# 스텝보다 뒤에 돌아서 그 뒤에 또 root 로 쓴다 — 실측(런 34030111531): 끝에서
# chown 을 하고도 `_temp` 아래에 root 소유 4,483건이 남았다(rust-cache 의 post 가
# cargo 레지스트리를 풀어 놓은 것). 그래서 애초에 root 가 아니게 만든다.
# uid·gid 1000 은 러너 사용자의 것이고 22.04 베이스에서 비어 있다(실측).
RUN groupadd -g 1000 runner \
 && useradd -m -u 1000 -g 1000 -s /bin/bash runner \
 && echo 'runner ALL=(ALL) NOPASSWD:ALL' > /etc/sudoers.d/runner \
 && chmod 0440 /etc/sudoers.d/runner
USER runner

# 굽는 시점에 계약을 못 지켰으면 여기서 선다 — 나중에 설치본이 안 도는 것보다 낫다.
RUN ldd --version | head -1 \
 && case "$(ldd --version | head -1)" in *2.35*) echo "glibc floor OK";; \
      *) echo "glibc 바닥이 2.35 가 아니다 — 베이스 이미지를 확인할 것" >&2; exit 1;; esac
