# vinc-layout — 시간 가지 배치 컨테이너(app/service/layout-server.mjs).
#
# 빌드 컨텍스트는 `node app/service/build.mjs <dir>` 가 만든 디렉터리 하나다(번들 한 파일과
# libavoid wasm). 앱의 의존성 전체를 이미지에 넣지 않는다. layout-deploy.yml 이 이 파일을
# 그 디렉터리에 Dockerfile 로 복사해 `az acr build` 한다.
# 근거: [[decision:time-branch-layout-is-computed-on-the-hub-per-topic-2026-10-12]]
FROM node:22.20.0-bookworm-slim

WORKDIR /srv
COPY layout-server.mjs libavoid.wasm /srv/

# 공간별로 들고 있는 조각·통로의 상한(바이트 근사). 컨테이너 메모리 2 GiB 에서 힙 1.5 GiB 안쪽.
ENV PORT=8080 \
    VINC_LAYOUT_MAX_BYTES=402653184 \
    NODE_ENV=production

USER node
EXPOSE 8080
CMD ["node", "--max-old-space-size=1536", "/srv/layout-server.mjs"]
