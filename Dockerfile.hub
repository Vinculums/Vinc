# Vinc 허브(사이드카+MCP) — Azure Container Apps 배포용.
# 데스크톱 배포는 PyInstaller(packaging/sidecar.spec)를 쓰지만, 서버 컨테이너는
# 정적분석 사각(동적 import) 문제와 무관하므로 그냥 `python -m api.cli`로 직접
# 실행한다 — PyInstaller 프리징 자체가 불필요.
FROM python:3.12-slim-bookworm

WORKDIR /srv/vinc

RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates \
    && update-ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# 드라이버 버전 핀(명칭 churn 대비, pyproject.toml 주석과 동일 근거).
# pypdf — 허브도 /doc/put-file 을 프록시로 받으므로 서버측 추출기가 필요하다.
RUN pip install --no-cache-dir ladybug==0.20.4 argon2-cffi pypdf==6.14.2

# 임베딩 워커 스택 — **torch 가 아니라 ONNX** 다(packaging/embed_worker.py 주석 참조).
# 이미지 260MB → 500MB(실측). torch 를 실으면 +2.7GB 이고 런타임 RSS 도 ~800MiB 라
# 1GiB 한도에 붙어 OOM 이 컨테이너 전체(=MCP 포함)를 죽인다. 한도를 올리면 상시
# 과금이 배증한다(허브는 min=max=1 이라 idle 도 24시간 청구).
# 모델 가중치(440MB)는 이미지에 굽지 않고 런타임에 영속 볼륨으로 받는다 — 허브는
# api/ 변경마다 배포되고 단일 writer 라 **배포 시간이 곧 다운타임**이다.
#
# 🔴 **판을 고정한다.** 질의 벡터와 저장된 벡터가 같은 런타임에서 나와야 한다. 같은 int8
# 모델이라도 onnxruntime 1.29 → 1.30 이면 질의 벡터가 전부 코사인 0.009~0.022 움직이고
# (의미 팔의 판정 격차 `_SEM_GAP` 0.010 보다 크다) 확신 오답이 늘어난다. 판을 풀어 두면
# 새 판이 나온 뒤의 첫 이미지 빌드가 질의 쪽만 조용히 바꾼다. onnxruntime·tokenizers·
# numpy 판은 2026-09-11 전량 재인코딩 때부터 허브가 쓴 판 그대로다(huggingface_hub 는
# 모델을 받기만 해서 벡터에 닿지 않지만 재현성을 위해 함께 고정한다). 앞의 셋을 올릴
# 때는 저장 벡터 전량 재인코딩과 한 배포로 묶는다.
# tests/test_encoder_runtime_pin.py 가 이 줄과 bake-probe 가 같은 판인지 잠근다.
# 근거: [[record:the-eval-drift-to-41-14-4-follows-the-query-encoder-runtime-not-the-engine-2026-09-28]]
RUN pip install --no-cache-dir onnxruntime==1.30.0 tokenizers==0.23.2 numpy==2.5.3 huggingface_hub==1.33.0

# ── 임베딩 모델을 **빌드 타임에** 양자화해 굽는다 ────────────────────────────────
# 모델 가중치를 이미지에 굽지 않는다는 기존 방침을 여기서 뒤집는다. 근거는 실측이다:
#
#   · 쓸 모델은 multilingual-e5-base 다(영어·한국어 병행 결정. 한국어 nDCG 0.347 →
#     0.670). fp32 는 **1,058MB** 라 1024MiB 컨테이너에 단독으로도 안 들어간다.
#   · 공식 int8(`model_qint8_avx512_vnni.onnx`)은 279MB 로 들어가지만
#     U8S8+per_channel+reduce_range=False 조합이라 non-VNNI CPU 에서 포화가 나
#     **에러 없이 품질만** 떨어진다(실측 한국어 nDCG 0.670 → 0.472).
#   · 그래서 `reduce_range=True` 로 직접 만들어야 하는데, **런타임 양자화는 불가능하다**:
#     e5 의 임베딩 행렬 하나가 192M float(732MB)이고 원본 모델까지 메모리에 올라가
#     피크가 1.5GB 를 넘는다(실측 — 컨테이너보다 넉넉한 기기에서도 OOM 났다).
#
# 결론: 양자화는 **메모리가 넉넉한 빌드 환경**에서 한 번 하고 결과 279MB 만 싣는다.
# 이미지가 500MB → 약 780MB 로 늘어 배포(=다운타임)가 그만큼 길어지는 것이 대가다.
# 런타임에는 다운로드도 양자화도 없다 — 첫 검색이 즉시 정상 품질로 뜬다.
# `onnx` 는 양자화에만 필요하므로 같은 레이어에서 지운다(이미지 비대 방지).
# ⚠ 굽는 코드는 **별도 파일**(`packaging/bake_embed_model.py`)이다. Dockerfile 안에
# heredoc(`python - <<'PY'`)으로 되돌리지 말 것 — ACR 클래식 빌더에서 heredoc 이
# `&&` 사슬과 줄 이음에 섞이면 셸이 본문을 못 받아 `python -` 이 **빈 stdin 으로 즉시
# 종료**한다. 빌드는 초록인데 모델은 안 구워지고, 런타임에 fp32(1GB) 로 폴백해 OOM 으로
# MCP 까지 죽는다(실측 run dem, 2026-08-01 — 이미지가 5MB 만 늘어 드러났다).
# 그 파일 머리주석에 전말이 있다. 굽기 결과는 그 스크립트가 직접 검증하고 실패시킨다.
# ⚠ **두 줄은 짝이다.** 파일명은 `packaging/embed_worker.py::artifact_name(모델)` 이
# 정하고, 런타임이 basename 을 대조해 어긋나면 **기동 시점에 예외로 끊는다**(전에는
# 모델만 바꾸면 옛 모델의 아티팩트를 그대로 집어 무음으로 딴 벡터를 만들었다).
# 모델을 바꿀 때는 **세 줄을 함께** 바꿀 것 — 어긋난 조합은 `tests/test_embed_worker.py`
# 와 `tests/test_bake_declares_the_right_width.py` 가 CI 에서 잡는다.
# bge-m3 로 가려면: BAAI/bge-m3 + …/bge-m3-int8-rr.onnx + 1024.
#
# 세 번째 줄(폭)이 왜 필요한가. 모델 교체는 차원 교체다(e5 768 · bge-m3 1024). 굽기가
# 확인하던 것은 파일 크기뿐이라, 로드는 되는데 폭이 틀린 아티팩트를 아무것도 안 잡았다.
# 이제 굽기가 실제로 한 번 돌려 폭을 재고 이 값과 대조한다 — 어긋나면 **빌드가 선다.**
# 그 검사가 없으면 어긋남은 재구축 도중, 옛 벡터를 이미 지운 뒤에 드러난다.
ENV VINC_EMBED_MODEL=BAAI/bge-m3
ENV VINC_EMBED_MODEL_PATH=/srv/vinc/models/bge-m3-int8-rr.onnx
ENV VINC_EMBED_DIM=1024
#
# 인코딩 배치 상한. 기본 8 은 e5-base(768) 시절 값이라 bge-m3(1024·24층)에서는
# 2Gi 안에 안 들어간다 — `vinc-encode` 가 최대 1773MB/2048MB 까지 올라가 exit 137 로
# 죽고, 그 사이 허브는 같은 문서에서 120초 타임아웃을 7분마다 반복한다.
# 근거: [[record:the-encoder-is-oom-killed-on-the-largest-document-2026-09-12]]
ENV VINC_EMBED_BATCH=2
#
# ── 굽기는 러너에서, 검증은 여기서 (2026-09-03) ──────────────────────────────
#
# 예전에는 이 자리에서 `pip install onnx` 하고 fp32 를 받아 양자화했다. **bge-m3 에서는
# 그것이 불가능하다**: ACR 빌드 에이전트가 2.27GB 를 다 받고 나서 `quantize_dynamic`
# 에서 OOM 으로 죽는다(실측 exit 137, bake-probe run 33716383547). vincacr 는 Basic
# 티어라 에이전트에 메모리를 더 줄 수 없다 — 전용 에이전트 풀은 Premium 기능이다.
#
# 그래서 **메모리를 쓰는 호출 하나만** hub-deploy 의 러너로 옮겼다. 아티팩트는 빌드
# 컨텍스트로 올라온다(`az acr build … .` 의 끝 점). 새 저장소도 자격증명도 워크플로도
# 없다. 덤으로 이 레이어에서 `pip install onnx` 와 2.27GB 다운로드가 사라졌다.
#
# 🔴 **검증은 옮기지 않았다.** `COPY` 는 `RUN` 처럼 빨개지지 못하고 잘린 파일은 조용히
# 성공하는데, 그 결과가 런타임에서 **영구 stall** 로 나온다(로드 예외가 문서별 except
# 에 삼켜지고 `/health` 는 200 을 유지한다). 아래 `RUN` 이 **COPY 된 바로 그 바이트**를
# 열어 추론을 돌리고 폭을 대조한다 — 그래서 "검증한 것 = 실은 것" 이 그대로다.
# 이 줄을 지우면 아무 테스트도 안 떨어지지만 그 성질이 사라진다.
#
# `models/` 가 없으면 이 COPY 가 **크게 죽는다.** 그것이 옳은 방향이다 — 조용히
# 안 구워진 이미지를 내보내는 것보다 낫다. 로컬에서 지으려면 먼저 굽는다:
#   python packaging/bake_embed_model.py     (VINC_EMBED_MODEL_PATH 를 models/ 로)
COPY models/ /srv/vinc/models/
COPY packaging/bake_embed_model.py /tmp/bake_embed_model.py
RUN python /tmp/bake_embed_model.py \
 && rm -f /tmp/bake_embed_model.py

COPY api ./api
COPY store ./store
COPY engines ./engines
COPY vinc_mcp ./vinc_mcp
COPY packaging/embed_worker.py ./packaging/embed_worker.py
# 검색 품질 게이트(E2)를 **허브 안에서** 돌리기 위해 싣는다. 이 게이트는 3팔(FTS·
# 벡터·RRF)을 갈라 재려고 스토어를 in-process 로 열어야 하는데, 사이드카가 물고 있는
# DB 는 **읽기 전용으로도 두 번째로 못 연다**(실측 2026-08-08: 허브 안에서도 실패).
# 그래서 공유의 스냅샷 사본을 `--data` 로 지정해 돌린다. 스크립트는 전부 작은 .py 다.
COPY scripts ./scripts
COPY pyproject.toml README.md LICENSE ./

# G0 오프라인 확장 — 빌드 컨테이너 네트워크에서 extension.ladybugdb.com 다운로드가
# SSL 검증 실패로 막혀(실측, Docker Desktop 빌드 환경 특유) 로컬에서 미리 받은
# linux_amd64 바이너리를 직접 굽는다. store/embedded_backend.py _bundled_ext_path
# 의 ②번 탐색 경로(VINC_LBUG_EXT_DIR env)가 "LOAD EXTENSION '<번들 경로>'" 명시
# 로드를 타서 완전 오프라인으로 성공한다(런타임 네트워크 불요, 이미 실측 확인됨).
COPY packaging/lbug_extensions ./lbug_extensions
ENV VINC_LBUG_EXT_DIR=/srv/vinc/lbug_extensions

# ── 네이티브 중단이 무엇도 안 남기지 않게 ────────────────────────────────────────
# 2026-08-28: 사이드카가 `munmap_chunk(): invalid pointer` **한 줄만** 남기고 죽었다.
# glibc 가 힙 손상을 보고 abort 한 것인데, 파이썬 트레이스백이 앞뒤로 없어서 어느
# 호출에서 났는지 끝내 못 짚었다 — 코어 덤프도 없고 재현도 안 됐다. 다음에 또 나면
# 같은 크기로 깜깜하다.
#
# `faulthandler` 는 SIGSEGV·SIGABRT·SIGBUS·SIGFPE·SIGILL 에 핸들러를 걸어 죽는 순간의
# **파이썬 스택을 stderr 로** 뱉는다. env 로 켜면 인터프리터 시작 시점부터라 import
# 중 크래시까지 덮고, 코드를 안 건드린다. 비용은 시그널 핸들러 등록뿐이다.
# 이 이미지의 세 프로세스(사이드카·MCP·임베딩 워커)에 모두 걸린다.
# 정본: vinc.ops.incident-2026-08-28-hub-sidecar §2·§7.
ENV PYTHONFAULTHANDLER=1

COPY packaging/docker-entrypoint.sh /usr/local/bin/vinc-entrypoint.sh
# ⚠ `mkdir -p /data` 이지 `/data/db` 가 아니다. `--data` 는 **DB 파일 경로**라서
# `/data/db` 를 디렉터리로 만들어 두면 LadybugDB 가 "Database path cannot be a
# directory" 로 죽고 `/health` 는 `driver: null` 만 보여준다 — 프로덕션에서는 Azure
# Files 마운트가 이 디렉터리를 덮어써서 드러나지 않았지만, 볼륨 없이 이 이미지를
# 돌리면(로컬 스모크·다른 환경) 재현된다. 실측으로 잡은 잠복 함정이고, 하필 증상이
# 단일 writer 락 사고와 똑같아서 오진하기 쉽다.
RUN chmod +x /usr/local/bin/vinc-entrypoint.sh && mkdir -p /data
# root 로 실행 — G0 확장 캐시(~/.lbdb)가 빌드 타임 유저(root) 홈에 구워지므로
# 런타임도 같은 유저여야 이름 기반 LOAD EXTENSION 이 그 캐시를 찾는다. non-root
# 전환은 캐시 경로를 함께 옮기는 별도 작업으로 미룬다(지금은 기능 검증 우선).

EXPOSE 8790
ENTRYPOINT ["/usr/local/bin/vinc-entrypoint.sh"]
