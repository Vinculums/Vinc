# Vinc MCP 어댑터 — Streamable HTTP + OAuth(루프백 8790, 공개는 Caddy 전담).
# 설치: /etc/systemd/system/vinc-mcp.service 로 복사 후
#   systemctl daemon-reload && systemctl enable --now vinc-mcp
[Unit]
Description=Vinc MCP adapter (Streamable HTTP + OAuth gate)
After=vinc-sidecar.service
Requires=vinc-sidecar.service

[Service]
Type=simple
User=vinc
Group=vinc
# /etc/vinc/mcp.env (권한 600 — D36: 시크릿은 서버 env 로만):
#   VINC_SIDECAR_TOKEN=<sidecar.env 와 동일 값>
#   VINC_OAUTH_ADMIN_KEY=<random — 커넥터 인가 1회에 사용(회원경로 활성 후 폐기 가능)>
#   VINC_MCP_ED25519_SEED=<base64 32B — MCP 서명키(계정이 공개키 핀)>
#   VINC_ACCOUNT_PUBLIC_KEY=<base64 32B — 계정 공개키(AA 검증용)>
#   VINC_ACCOUNT_INTERNAL_URL=http://127.0.0.1:8080  (verify-key 루프백)
EnvironmentFile=/etc/vinc/mcp.env
# 티어 쿼터(B-D2) — 인증 회원의 tools/call 만 소비(핸드셰이크 무료).
# 카운터는 owner(public_id) 단위라 키를 여러 개 만들어도 합산된다.
Environment=VINC_QUOTA=on
Environment=VINC_FREE_DAILY_LIMIT=15
Environment=VINC_PRO_DAILY_LIMIT=2000
Environment=VINC_QUOTA_WINDOW_HOURS=24
Environment=VINC_QUOTA_LOCK_HOURS=12
# OAuth·쿼터 상태 영속 경로(B-A). ProtectHome=read-only 라 홈엔 못 쓰므로
# StateDirectory 로 /var/lib/vinc-mcp(0700, vinc:vinc)를 확보하고 env 로 명시한다.
# 이 줄이 없으면 SQLite 쓰기가 막혀 기동/영속이 실패한다(배포 3단계 게이트).
StateDirectory=vinc-mcp
Environment=VINC_MCP_STATE_DIR=/var/lib/vinc-mcp
ExecStart=/opt/vinc/vinc-sidecar mcp serve-http --no-spawn \
    --host 127.0.0.1 --port 8790 \
    --token ${VINC_SIDECAR_TOKEN} \
    --oauth --issuer https://mcp.${VINC_DOMAIN}
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true

[Install]
WantedBy=multi-user.target
