# Vinc 원격 프로파일(D36 §5) — Caddy 리버스 프록시 + 자동 TLS.
# 적용: VINC_DOMAIN(정본=vincs.io) + VINC_LEGACY_DOMAIN(구=vincs.app) 을 systemd 로 주입
#   (caddy.service.d/override.conf), /etc/caddy/Caddyfile 로 복사, `caddy validate`
#   (env 주입 필요) → `systemctl reload caddy`. 이 파일은 배포 정본과 1:1.
#
# 도메인 이전 컷오버(vincs.app→vincs.io):
#   - {$VINC_DOMAIN}=vincs.io 가 정본(사이트+API+MCP).
#   - {$VINC_LEGACY_DOMAIN}=vincs.app 는 병행:
#       · /api·/internal·/connect-app·/auth·/account·/subscribe·/unsubscribe 는 계속
#         서빙(기존 이메일 매직링크·이미 배포된 데스크탑 클라이언트가 여기로 온다.
#         특히 /connect-app 은 구 클라이언트의 로컬 사이드카가 Origin: vincs.app 으로만
#         허용하므로 반드시 vincs.app 에서 서빙돼야 한다 — 301 하면 구 클라이언트 깨짐).
#       · 그 외 마케팅 경로는 정본으로 301.
#   - mcp.{$VINC_LEGACY_DOMAIN} 도 계속 서빙(구 클라이언트 sync·미재등록 커넥터 대상).
# 구 도메인은 이미 배포된 클라이언트 소진까지(어쩌면 무기한) 은퇴하지 않는다.

# ── 정본 도메인 (vincs.io) ──────────────────────────────────────────────────
{$VINC_DOMAIN} {
    reverse_proxy /api/* 127.0.0.1:8080

    root * /srv/www
    file_server
    encode zstd gzip

    # ── 캐시 정책 ──────────────────────────────────────────────────────────
    @mutshared path /assets/gnb.js /assets/tokens.css /assets/site.css
    header @mutshared Cache-Control "no-cache"
    @immutable {
        path /app/assets/* /community/assets/* /assets/*
        not path /assets/gnb.js /assets/tokens.css /assets/site.css
    }
    header @immutable Cache-Control "public, max-age=31536000, immutable"
    @nostore path /api/* /internal/*
    header @nostore Cache-Control "no-store"
    @revalidate not path /app/assets/* /community/assets/* /assets/* /api/* /internal/*
    header @revalidate Cache-Control "no-cache"

    header {
        Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; frame-ancestors 'none'"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "no-referrer"
        X-Frame-Options "DENY"
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
    }
}

# ── 구 도메인 (vincs.app) — 상호작용 경로는 서빙, 마케팅은 301 ──────────────────
{$VINC_LEGACY_DOMAIN} {
    @keep path /api/* /internal/* /connect-app* /auth/* /account/* /subscribe/* /unsubscribe*
    handle @keep {
        reverse_proxy /api/* 127.0.0.1:8080
        root * /srv/www
        file_server
        @nostore2 path /api/* /internal/*
        header @nostore2 Cache-Control "no-store"
    }
    handle {
        redir https://{$VINC_DOMAIN}{uri} 301
    }
    header Strict-Transport-Security "max-age=31536000; includeSubDomains"
}

# ── 정본 MCP (mcp.vincs.io) ─────────────────────────────────────────────────
mcp.{$VINC_DOMAIN} {
    @internal path /internal/*
    respond @internal 404
    reverse_proxy 127.0.0.1:8790
}

# ── 구 MCP (mcp.vincs.app) — 계속 서빙(구 클라이언트 sync·미재등록 커넥터) ──────────
mcp.{$VINC_LEGACY_DOMAIN} {
    @internal path /internal/*
    respond @internal 404
    reverse_proxy 127.0.0.1:8790
}
