# Vinc 원격 프로파일(D36 §5) — Caddy 리버스 프록시 + 자동 TLS.
# 적용: VINC_DOMAIN(정본) 과 VINC_LEGACY_DOMAIN(구 도메인, 병행) 을 env 로 주입
#   (systemd Environment=VINC_DOMAIN=vincs.io  Environment=VINC_LEGACY_DOMAIN=vincs.app),
#   /etc/caddy/Caddyfile 로 복사, `caddy validate` → `systemctl reload caddy`.
# 이 파일은 배포 정본과 1:1 — 편집 시 서버에도 반영할 것.
#
# 도메인 이전(vincs.app→vincs.io):
#   - {$VINC_DOMAIN}=vincs.io 가 정본(사이트+API+MCP).
#   - {$VINC_LEGACY_DOMAIN}=vincs.app 는 병행 유지:
#       · /api/*·/connect-app·/auth/*·/account/*·/subscribe/*·/unsubscribe 는 계속 서빙
#         (기존 이메일 매직링크·이미 배포된 데스크탑 클라이언트가 여기로 온다).
#       · 그 외 마케팅 경로는 정본으로 301.
#   - mcp.{$VINC_LEGACY_DOMAIN} 도 계속 서빙(claude.ai 커넥터·기존 클라이언트 sync 대상).
# 구 도메인은 이미 배포된 클라이언트가 소진될 때까지(어쩌면 무기한) 은퇴하지 않는다.

# ── 정본 도메인 (vincs.io) ──────────────────────────────────────────────────
{$VINC_DOMAIN} {
    reverse_proxy /api/* 127.0.0.1:8080

    root * /srv/www
    file_server
    encode zstd gzip

    @immutable path /app/assets/* /community/assets/* /assets/*
    header @immutable Cache-Control "public, max-age=31536000, immutable"
    @nostore path /api/* /internal/*
    header @nostore Cache-Control "no-store"
    @revalidate not path /app/assets/* /community/assets/* /assets/* /api/* /internal/*
    header @revalidate Cache-Control "no-cache"

    header {
        Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; frame-ancestors 'none'"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "no-referrer"
        X-Frame-Options "DENY"
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
    }
}

# ── 구 도메인 (vincs.app) — 병행: 상호작용 경로는 서빙, 마케팅은 301 ──────────────
{$VINC_LEGACY_DOMAIN} {
    # 상호작용 경로는 계속 서빙(기존 이메일 링크·데스크탑 클라이언트). 오리진은
    # 계정 백엔드 allowedOrigins·사이드카 VINC_CONNECT_ORIGINS 가 두 도메인 다 허용.
    @keep path /api/* /internal/* /connect-app* /auth/* /account/* /subscribe/* /unsubscribe*
    handle @keep {
        reverse_proxy /api/* 127.0.0.1:8080
        root * /srv/www
        file_server
        @nostore2 path /api/* /internal/*
        header @nostore2 Cache-Control "no-store"
    }
    # 그 외(홈·guide·download·release·community·privacy 등 마케팅) → 정본으로 영구 이전.
    handle {
        redir https://{$VINC_DOMAIN}{uri} 301
    }
    header Strict-Transport-Security "max-age=31536000; includeSubDomains"
}

# ── 정본 MCP (mcp.vincs.io) ─────────────────────────────────────────────────
mcp.{$VINC_DOMAIN} {
    @internal path /internal/*
    respond @internal 404
    reverse_proxy 127.0.0.1:8790
}

# ── 구 MCP (mcp.vincs.app) — 병행: claude.ai 커넥터·기존 클라이언트 sync 대상 ──────
# 리다이렉트 불가(OAuth 발급자·스트리밍 API·등록된 커넥터 URL이 이 호스트를 가리킴).
mcp.{$VINC_LEGACY_DOMAIN} {
    @internal path /internal/*
    respond @internal 404
    reverse_proxy 127.0.0.1:8790
}
