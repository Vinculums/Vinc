{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vinc",
  "mainBinaryName": "vinc-app",
  "version": "0.9.3",
  "identifier": "app.vinc.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Vinc — Mine what matters.",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "dragDropEnabled": false,
        "decorations": false,
        "backgroundColor": "#0A0A0A"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; connect-src 'self' http://127.0.0.1:*; style-src 'self' 'unsafe-inline'"
    },
    "withGlobalTauri": false
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Vinculums/Vincs-app/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQzOTRERTQyRDUwRTBDQTkKUldTcERBN1ZRdDZVUStBa081UGZKTFlvOHRKeGROL3JBZnU1dG9sSTBwVUZkQWNFVlY4OFlMWm0K"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "category": "Productivity",
    "shortDescription": "Your knowledge graph on the desktop, the same as on the web.",
    "longDescription": "Ingest a corpus, map it as a graph, search it by meaning, and export packs, in your account or, in local mode, on this machine.",
    "externalBin": ["binaries/vinc"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["vincpack"],
        "name": "Vinc Pack",
        "description": "Portable Vinc knowledge pack",
        "role": "Viewer"
      }
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "installerHooks": "windows/hooks.nsh",
        "displayLanguageSelector": true,
        "languages": ["English", "Korean"]
      }
    }
  }
}
