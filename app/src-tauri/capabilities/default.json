{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Vinc 셸 기본 권한 — 창 제어 · 파일 다이얼로그 · 사이드카 spawn · 프론트 로그 기록.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-is-maximized",
    "dialog:default",
    "shell:allow-open",
    "updater:default",
    "process:default",
    "log:default"
  ]
}
