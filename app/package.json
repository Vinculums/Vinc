{
  "name": "vinc-app",
  "private": true,
  "version": "0.9.8",
  "description": "Vinc desktop UI — 5 surfaces + Settings (D15), View semantic zoom (D16). Frontend for the local sidecar; Tauri shell wrap is P4.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test:search-temporal": "node --test tests/search-temporal.test.mjs",
    "build": "npm run typecheck && npm run test:search-temporal && npm run test:view-controls && npm run test:view-links && npm run test:view-idle && npm run test:view-layout && npm run test:view-loading && npm run test:view-session && npm run test:view-graph-read && npm run test:view-retained && npm run test:layout-service && npm run test:topic-conversion && npm run test:topic-detail && vite build",
    "test:view-idle": "node --test tests/view-idle-frames.test.mjs",
    "test:view-links": "node --test tests/view-link-performance.test.mjs",
    "test:view-controls": "node --test tests/view-controls.test.mjs",
    "test:view-loading": "node --test tests/view-graph-loading.test.mjs",
    "test:view-layout": "node --test tests/view-layout.test.mjs",
    "test:timeline-panel": "node dev/timeline-panel-check.mjs",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "tauri": "tauri",
    "test:view-session": "node --test tests/view-session-cache.test.mjs",
    "test:view-graph-read": "node --test tests/view-graph-read.test.mjs tests/view-graph-loader.test.mjs",
    "test:view-retained": "node --test tests/view-retained.test.mjs",
    "test:layout-service": "node --test tests/layout-service.test.mjs",
    "build:layout-service": "node service/build.mjs",
    "test:topic-conversion": "node --test tests/topic-conversion.test.mjs tests/conversion-inventory.test.mjs",
    "test:topic-detail": "node --test tests/topic-detail.test.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@sigma/node-border": "^3.0.0",
    "@sigma/node-image": "^3.0.0",
    "@tauri-apps/api": "^2.12.1",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.13.2",
    "3d-force-graph": "^1.80.1",
    "elkjs": "0.12.0",
    "graphology": "^0.26.0",
    "katex": "^0.19.0",
    "libavoid-js": "0.4.5",
    "mermaid": "^11.17.2",
    "sigma": "^3.0.3",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.1",
    "@types/three": "^0.186.0",
    "typescript": "^5.6.0",
    "vite": "^6.4.4"
  }
}
